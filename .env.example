# iPlex Web — variáveis de ambiente (copie para .env.local; nunca versione segredos)

# ---------------------------------------------------------------------------
# Públicas (entram no bundle; prefixo VITE_). Configuração web do Firebase
# iplex-2c8fc: não é segredo, mas fica fora do código para trocar por ambiente.
# Obtenha com: firebase apps:sdkconfig WEB <appId> --project iplex-2c8fc
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=iplex-2c8fc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=iplex-2c8fc
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=iplex-2c8fc.firebasestorage.app
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# App Check (obrigatório: a callable `manager` do backend exige App Check fora
# do emulador). Chave de site reCAPTCHA Enterprise registrada no App Check do
# app web "iPlex Web" (valores de produção em .env.production).
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Origens aceitas para mensagens do shell (ponte). O shell Tizen empacotado tem
# origem opaca ("null"/"file://"). Lista separada por vírgula.
VITE_IPLEX_SHELL_ORIGINS=null,file://

# Somente desenvolvimento: dados de demonstração isolados (src/dev/mock).
# Ignorado em builds de produção.
VITE_IPLEX_USE_MOCKS=false

# ---------------------------------------------------------------------------
# Exclusivas do servidor (NUNCA com prefixo VITE_). Usadas pelo proxy TMDB:
# - em desenvolvimento, pelo middleware do Vite (server/);
# - em produção, como segredos da Cloud Function (firebase functions:secrets:set).
# ---------------------------------------------------------------------------
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
